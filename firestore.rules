rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isCoupleMember(coupleId) {
      return signedIn()
        && get(/databases/$(database)/documents/couples/$(coupleId))
          .data.members[request.auth.uid] == true;
    }

    match /users/{uid} {
      allow get, create, update: if signedIn() && request.auth.uid == uid;
      allow list, delete: if false;
    }

    match /couples/{coupleId} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members[request.auth.uid] == true;

      allow get: if isCoupleMember(coupleId);

      allow update: if isCoupleMember(coupleId)
        && request.resource.data.members.keys().size() <= 2;

      allow delete: if false;

      match /profiles/{uid} {
        allow read, write: if isCoupleMember(coupleId)
          && (request.auth.uid == uid || request.method == "get");
      }

      match /messages/{messageId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string;
        allow update, delete: if isCoupleMember(coupleId)
          && resource.data.senderId == request.auth.uid;
      }

      match /events/{eventId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
          && request.resource.data.title is string
          && request.resource.data.date is string;
        allow update, delete: if isCoupleMember(coupleId);
      }

      match /money/{moneyId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.amount is number
          && request.resource.data.description is string
          && request.resource.data.type in ["income", "expense"];
        allow update, delete: if isCoupleMember(coupleId)
          && resource.data.userId == request.auth.uid;
      }
    }
  }
}
